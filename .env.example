# Copy this file to .env.local and fill in values.
# Marketing pages (/, /features, /pricing) work without these.
# Login and dashboard require the "Required" section.

# ── Required for auth & dashboard ─────────────────────────────────────────────

# PostgreSQL connection string (Supabase → Project Settings → Database)
DATABASE_URL=

# Random secret — run: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth URLs ────────────────────────────────────────────────────────────────
# Local only — do NOT set BETTER_AUTH_URL=http://localhost:3000 on Vercel.
# On Vercel, Better Auth derives the host from the request (see lib/auth.ts).
# For production, set both to your public HTTPS origin, e.g.:
#   BETTER_AUTH_URL=https://your-app.vercel.app
#   NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Google Cloud Console → OAuth client → Authorized redirect URIs must include:
#   https://<your-host>/api/auth/callback/google
# (Google does not allow *.vercel.app wildcards — add each host you use.)

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Legal / company identity (Jamaica) ───────────────────────────────────────
# Shown on Privacy, Terms, footer, and merchant disclosures.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Marketme
NEXT_PUBLIC_LEGAL_ADDRESS=Kingston, Jamaica
NEXT_PUBLIC_COMPANY_REGISTRATION=
NEXT_PUBLIC_LEGAL_EMAIL=legal@marketme.app
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@marketme.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@marketme.app

# ── Optional integrations ─────────────────────────────────────────────────────

# Google OAuth (login page)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic link emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Marketme <onboarding@resend.dev>

# External AI / publish service (server-only). Required in production.
# Defaults to http://localhost:8000 in development when unset.
# Dashboard Generate prefers this pipeline over OPENAI_API_KEY when set.
MARKETME_AI_API_URL=
# Optional service credential forwarded as Authorization + X-API-Key when set.
MARKETME_AI_API_KEY=
# Optional: force integer business_id for the AI API (otherwise derived from profile UUID).
# MARKETME_AI_BUSINESS_ID=

# On the MarketMe AI API (Render), set FRONTEND_URL to this Next app origin, e.g.:
#   FRONTEND_URL=http://localhost:3000
# After Meta OAuth the API should redirect to:
#   {FRONTEND_URL}/dashboard/connections?oauth=instagram&status=success

# AI content generation (caption revise, image gen, Generate fallback)
OPENAI_API_KEY=

# Trigger.dev background jobs (image gen, scheduled publishing)
TRIGGER_SECRET_KEY=

# Stock images (studio)
PEXELS_API_KEY=

# Billing
STRIPE_SECRET_KEY=

# Better Auth dashboard plugin
BETTER_AUTH_API_KEY=

# Login session limits (seconds). Defaults: 7 days lifetime, refresh at most once/day while active.
# Example shorter idle-style window: AUTH_SESSION_EXPIRES_IN=28800 (8h), AUTH_SESSION_UPDATE_AGE=3600 (1h)
AUTH_SESSION_EXPIRES_IN=604800
AUTH_SESSION_UPDATE_AGE=86400

# Auto-publish scheduled posts to Instagram (requires Instagram connection).
# Either flag enables Trigger.dev scheduled-publishing + /api/cron/publish-scheduled.
# Set the same value on Trigger.dev production AND Vercel for live publishing.
ENABLE_AUTO_PUBLISH=false
# Alias used by MarketMe AI / shared env — also accepted by this app:
# INSTAGRAM_PUBLISH_ENABLED=false

# Protects GET/POST /api/cron/publish-scheduled (Vercel Cron sends Bearer automatically when set).
CRON_SECRET=

# Optional salt for first-party pageview visitor hashes (defaults to UTC date).
# ANALYTICS_VISITOR_SALT=

# Supabase storage bucket for generated content
NEXT_PUBLIC_SUPABASE_BUCKET=generated-content

# ── Admin Console Access ──────────────────────────────────────────────────────
# Preferred (live): set is_admin = true on public."user" in Supabase
#   UPDATE public."user" SET is_admin = true WHERE email = 'you@example.com';
# Optional bootstrap / local fallback (not required in production if DB flag is set):
# Example: ADMIN_EMAILS=dev1@marketme.app,dev2@marketme.app
ADMIN_EMAILS=
